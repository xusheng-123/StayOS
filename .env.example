# Run scripts/init-local.ps1 to generate a private .env with a random database password.
STAYOS_DB_NAME=stayos
STAYOS_DB_USER=stayos
STAYOS_DB_PASSWORD=
STAYOS_DB_PORT=15432
STAYOS_TEST_DB_PORT=15433
# Generate once using scripts/init-guest-key.ps1; do not replace after storing guest data.
STAYOS_GUEST_ENCRYPTION_KEY=
# Optional in local development; required and independently recorded for the prod profile.
# scripts/show-guest-key-fingerprint.ps1 prints the fingerprint, never the key.
STAYOS_GUEST_KEY_FINGERPRINT=
# Empty means ignore all forwarded client-IP headers. Configure only the actual trusted proxy.
STAYOS_TRUSTED_PROXIES=
# Production only: independent restricted runtime credentials and migration credentials.
STAYOS_RUNTIME_DB_USER=
STAYOS_RUNTIME_DB_PASSWORD=
STAYOS_MIGRATION_DB_USER=
STAYOS_MIGRATION_DB_PASSWORD=

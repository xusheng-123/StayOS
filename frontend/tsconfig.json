{
  "compilerOptions": {
    "target": "ES2022", "useDefineForClassFields": true,
    "module": "ESNext", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "Bundler", "skipLibCheck": true, "strict": true,
    "noUnusedLocals": true, "noUnusedParameters": true,
    "resolveJsonModule": true, "isolatedModules": true, "noEmit": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts", "playwright.config.ts", "e2e/**/*.ts"]
}
